<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="Philippe De Muyter Licenser" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="autoconf/tea/win/nmakehlp.c"
                    desc="" />
                <filteritem type="filepath" name=".*vc"
                    desc="" />
                <filteritem type="filepath" name="manifest"
                    desc="" />
                <filteritem type="filepath" name="install-sh"
                    desc="" />
                <filteritem type="filepath" name="ext/wasm/dist.make"
                    desc="" />
                <filteritem type="filepath" name="autoconf/tea/tclconfig/tcl.m4"
                    desc="" /> 
                <filteritem type="filepath" name="autoconf/tea/win/rules.vc"
                    desc="" />
                <filteritem type="filepath" name="tool/stripccomments.c"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name="vsixtest/vsixtest_TemporaryKey.pfx"
                    desc="" />
                <filteritem type="filepath" name="test.*db"
                    desc="" />
                <filteritem type="filepath" name="art/sqlite370.ico"
                    desc="" />
                <filteritem type="filepath" name="art/sqlite370.jpg"
                    desc="" />
                <filteritem type="filepath" name=".*png"
                    desc="" />
                <filteritem type="filepath" name="tool/win/sqlite.vsix"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="FSFAP" desc="">
                <licensetext name="
                Copying and distribution of this file, with or without modification,
                are permitted in any medium without royalty provided the copyright
                notice and this notice are preserved.  This file is offered as-is,
                without warranty of any kind.
            " desc="" />
            </licensematcher> 
            <licensematcher name="GPL-3.0-or-later" desc="">
                <licensetext name="
                # This file is free software; you can redistribute it and/or modify it
                # under the terms of the GNU General Public License as published by
                # the Free Software Foundation; either version 3 of the License, or
                # (at your option) any later version.
            " desc="" />
            </licensematcher>
            <licensematcher name="Philippe De Muyter Licenser" desc="">
                <licensetext name="
                # This program is distributed in the hope that it will be useful,
                # but without any warranty; without even the implied warranty of
                # merchantability or fitness for a particular purpose.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>