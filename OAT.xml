<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="Technology" path=".*" desc="" />
                <policyitem type="compatibility" name="Gravereaux" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="third_party/llvm-10.0/llvm/include/llvm/Support/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Tools/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/bloat/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-10.0/Android.bp"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Headers/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name="autoconf/tea/tclconfig/tcl.m4"
                    desc="" />
                <filteritem type="filepath" name="ext/wasm/dist.make"
                    desc="" />
                <filteritem type="filepath" name="test/wapp.tcl"
                    desc="" />
                <filteritem type="filepath" name="tool/stripccomments.c"
                    desc="" />
                <filteritem type="filepath" name="manifest"
                    desc="" />
                <filteritem type="filepath" name="autoconf/INSTALL"
                    desc="" />
                <filteritem type="filepath" name="autoconf/tea/win/makefile.vc"
                    desc="" />
                <filteritem type="filepath" name="autoconf/tea/win/rules.vc"
                    desc="" />
                </filefilter>
                <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter> 
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Technology" desc="">
                <licensetext name="
                # Copyright 1991 by the Massachusetts Institute of Technology
            " desc="" />
            </licensematcher>

            <licensematcher name="Gravereaux" desc="">
                <licensetext name="
                * Copyright (c) 2002 by David Gravereaux.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>